# Segredos (copie .env.example para .env)
.env

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Dados gerados (data lake e exportações completas)
area2-bigdata/datalake/landing/*
!area2-bigdata/datalake/landing/.gitkeep
area2-bigdata/powerbi/dados/
area1-ia/modelo/
# relatorios/ fica no git (vazia) para existir no clone com o dono certo; o conteúdo é gerado
relatorios/*
!relatorios/.gitkeep

# Sistema
.DS_Store

# App (area3-mvp/app tem o próprio .gitignore; estes garantem o mesmo na raiz)
node_modules/
area3-mvp/app/dist/
area3-mvp/app/.expo/
area3-mvp/app/coverage/
