# Copie para .env antes de subir:   cp .env.example .env
# As senhas abaixo são de desenvolvimento local. Troque-as se for expor o projeto.

# PostgreSQL (o usuário "migrador" é o dono das tabelas)
POSTGRES_DB=citizentech
POSTGRES_USER=migrador
POSTGRES_PASSWORD=dev-migrador-troque
INGESTOR_DB_PASSWORD=dev-ingestor-troque
BI_DB_PASSWORD=dev-bi-troque
IA_DB_PASSWORD=dev-ia-troque

# MQTT (Mosquitto): uma senha por usuário
MQTT_INGESTOR_PASSWORD=dev-mqtt-ingestor-troque
MQTT_SIMULADOR_PASSWORD=dev-mqtt-simulador-troque
MQTT_PONTE_PASSWORD=dev-mqtt-ponte-troque

# Simulação
# Dias da série histórica gerada na primeira subida
HISTORICO_DIAS=30
# Mesma semente = mesmos dados
SIM_SEMENTE=42
# ciclo | normal | chuva_forte | enchente
SIM_CENARIO=ciclo
# 600 = 10 minutos simulados por segundo real
SIM_VELOCIDADE=600

# Ponte do Wokwi (perfil "wokwi"). Os mesmos valores estão no sketch do ESP32.
# É uma chave de DEMONSTRAÇÃO: o projeto no Wokwi é público, então ela não é segredo.
# Para uso real, gere outra (python -c "import secrets; print(secrets.token_hex(16))")
# e troque nos dois lugares.
WOKWI_BROKER=broker.hivemq.com
WOKWI_PREFIXO=gs20262-citizentech-421c5520aa65
WOKWI_CHAVE=6c4dbe1fe811caa16936fbe757849afc

# API de IA (área 1): origens que podem chamar a API pelo navegador (app React da fase 3)
API_CORS_ORIGENS=http://localhost:5173
