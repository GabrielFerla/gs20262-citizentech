{
  "expo": {
    "name": "Abriga",
    "slug": "abriga",
    "description": "Alerta de cheia em Porto Alegre e onde ficar seguro: um abrigo que vai ter vaga na chegada e não vai alagar.",
    "version": "1.0.0",
    "scheme": "abriga",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#1F7A5C",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F7A5C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "Abriga",
      "shortName": "Abriga",
      "lang": "pt-BR",
      "themeColor": "#1F7A5C",
      "backgroundColor": "#F5F8FA",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Abriga usa sua localização só neste aparelho, para achar o abrigo seguro mais perto. Ela não é enviada a nenhum servidor."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F7A5C"
        }
      ],
      "expo-font",
      "expo-asset"
    ]
  }
}
