{
  "name": "abriga",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.107.1",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "jest-junit": "^17.0.0",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --reporters=default --reporters=jest-junit",
    "build:web": "expo export -p web",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"test-utils/**/*.{ts,tsx}\""
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/test-utils/"
    ],
    "clearMocks": true,
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "jest-junit": {
    "outputDirectory": "../../relatorios",
    "outputName": "app.xml",
    "suiteNameTemplate": "{filepath}",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}"
  }
}
